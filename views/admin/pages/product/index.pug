extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug
include ../../mixins/moment.pug

block main
    if(role.permission.includes("products_view"))
        +alert-success(5000)
                

        h1 Danh sách sản phẩm

        .card.mb-3
            .card-header Bộ lọc và Tìm kiếm
            .card-body
                .row
                    .col-6
                        +filterStatus(filterStatus)
                    .col-6
                        +search(keyword)
                        
        .card.mb-3
            .card-header Sắp xếp
            .card-body
                .row
                    .col-4
                        +sort() 

        .card.mb-3
            .card-header Danh sách sản phẩm
            .card-body
                .row    
                    .col-8 
                        +formChangeMulti(`${prefixAdmin}/products/change-multi?_method=PATCH`)
                    .col-4 
                        if(role.permission.includes("products_create"))
                            a(
                                href=`${prefixAdmin}/products/create`
                                class="btn btn-outline-success"
                            ) + Thêm mới
                
                table(
                    class="table table-hover table-sm"
                    checkbox-multi 
                    )
                    thead
                    tr
                        th  
                            input(type="checkbox" name="checkall")
                        th STT
                        th Hình ảnh
                        th Tiêu đề
                        th Giá
                        th Vị trí
                        th Trạng thái
                        th Người tạo
                        th Hành động
                    tbody
                    each items,index in products
                        tr
                            td 
                                input(
                                    type="checkbox"
                                    name="id"
                                    value=items.id 
                                    )
                            td #{pagination.limitItems*(pagination.currentPage-1)+(index+1)}
                            td 
                                img(src = items.thumbnail, alt=items.title, width="100", height="auto")
                            td #{items.title}
                            td #{items.price}$
                            td 
                                input(
                                    type="number"
                                    value=items.position 
                                    style="width: 60px"
                                    min="1"
                                    name="position"
                                )
                            td
                                if(role.permission.includes("products_edit"))
                                    if(items.status == "active")
                                        a(
                                            href="javascript:;" 
                                            data-status=items.status 
                                            data-id=items.id
                                            button-change-status
                                            class="badge badge-success"
                                            ) Hoạt động 
                                    else
                                        a(
                                            href="javascript:;" 
                                            data-status=items.status 
                                            data-id=items.id
                                            button-change-status
                                            class="badge badge-danger" 
                                            ) Dừng hoạt động
                            td 
                                p #{items.accountFullName}
                                p
                                    +formatDate(items.createdBy.createdAt)
                            td
                                a(
                                    href=`${prefixAdmin}/products/detail/${items.id}`
                                    class="btn btn-secondary btn-sm"
                                    ) Chi tiết
                                if(role.permission.includes("products_edit"))    
                                    a(
                                        href=`${prefixAdmin}/products/edit/${items.id}`
                                        class="btn btn-warning btn-sm"
                                        ) Sửa
                                if(role.permission.includes("products_delete"))
                                    button(
                                        class="btn btn-danger btn-sm ml-1"
                                        button-delete
                                        data-id = items.id
                                        ) Xóa


        +pagination(pagination)

        form(
            action=""
            method="POST"
            id="form-change-status"
            data-path=`${prefixAdmin}/products/change-status`
        )

        form(
            action=""
            method="POST"
            id="form-delete-id"
            data-path=`${prefixAdmin}/products/delete`
        )

        script(src="/admin/js/products.js") 
    else 
        h1 Bạn không có quyền truy cập.
        
    